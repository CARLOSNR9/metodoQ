rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Campos que SOLO el servidor (Admin SDK) puede escribir: plan, rol,
    // pagos y acceso al módulo de pago único MIR.
    function protectedUserFields() {
      return ['plan', 'planStartedAt', 'planExpiresAt', 'planBillingCycle',
              'role', 'manualSale', 'lastPaymentStatus', 'lastPaymentProvider',
              'billingCycleMonths', 'stripeCheckoutSessionId', 'stripeCustomerId',
              'stripeSubscriptionId', 'planActivatedAt', 'mirAccess'];
    }

    // Verifica que ningún campo protegido sea modificado por el cliente
    function noProtectedFieldsChanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(protectedUserFields());
    }

    // Un perfil creado desde el cliente solo puede nacer sin privilegios:
    // plan FREE, rol student, sin fechas de plan y sin el resto de campos
    // protegidos (lo que escribe createDefaultUserDoc en src/lib/auth.ts).
    function isUnprivilegedNewUser() {
      let data = request.resource.data;
      return data.get('plan', 'FREE') == 'FREE'
        && data.get('role', 'student') == 'student'
        && data.get('planStartedAt', null) == null
        && data.get('planExpiresAt', null) == null
        && !data.keys().hasAny(['planBillingCycle', 'manualSale', 'lastPaymentStatus',
                                'lastPaymentProvider', 'billingCycleMonths',
                                'stripeCheckoutSessionId', 'stripeCustomerId',
                                'stripeSubscriptionId', 'planActivatedAt', 'mirAccess']);
    }

    // Perfil del usuario: lectura completa para el dueño;
    // escritura restringida — el cliente NO puede modificar plan, role, campos de pago ni mirAccess.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isUnprivilegedNewUser();
      allow update: if isOwner(userId) && noProtectedFieldsChanged();
      allow delete: if false;

      // Notas guardadas desde píldoras de teoría en entrenamiento
      match /studyNotes/{noteId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Borrador de simulacro/convocatoria para retomar tras un corte
      match /examDrafts/{draftId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // Resultados de entrenamiento del usuario
    match /results/{resultId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Preguntas activas: lectura para usuarios autenticados; escritura solo vía Admin SDK
    match /questions/{questionId} {
      allow read: if isSignedIn() && resource.data.active == true;
      allow write: if false;
    }

    // Postulaciones plan Residente (solo servidor / Admin SDK)
    match /residente_applications/{applicationId} {
      allow read, write: if false;
    }

    // Preguntas reportadas por admin (solo servidor / Admin SDK)
    match /question_reports/{reportId} {
      allow read, write: if false;
    }

    // Eventos de analítica (cliente)
    match /analytics_events/{eventId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    // Clases en vivo: lectura para usuarios autenticados; escritura solo Admin SDK
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Cursos del profesor: lectura para matriculados o el docente; escritura solo Admin SDK
    match /courses/{courseId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.professorId ||
        request.auth.uid in resource.data.studentIds
      );
      allow write: if false;
    }

    // Asistencia a clases: solo servidor (Admin SDK)
    match /class_attendance/{recordId} {
      allow read, write: if false;
    }

    // Notificaciones de logros del usuario
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
