rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Perfil del usuario: solo el dueño puede leer/escribir su documento
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Resultados de entrenamiento del usuario
    match /results/{resultId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Preguntas activas: lectura para usuarios autenticados; escritura solo vía Admin SDK
    match /questions/{questionId} {
      allow read: if isSignedIn() && resource.data.active == true;
      allow write: if false;
    }

    // Postulaciones plan Residente (solo servidor / Admin SDK)
    match /residente_applications/{applicationId} {
      allow read, write: if false;
    }

    // Eventos de analítica (cliente)
    match /analytics_events/{eventId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
