rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Perfil del usuario: solo el dueño puede leer/escribir su documento
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Notas guardadas desde píldoras de teoría en entrenamiento
      match /studyNotes/{noteId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // Resultados de entrenamiento del usuario
    match /results/{resultId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Preguntas activas: lectura para usuarios autenticados; escritura solo vía Admin SDK
    match /questions/{questionId} {
      allow read: if isSignedIn() && resource.data.active == true;
      allow write: if false;
    }

    // Postulaciones plan Residente (solo servidor / Admin SDK)
    match /residente_applications/{applicationId} {
      allow read, write: if false;
    }

    // Eventos de analítica (cliente)
    match /analytics_events/{eventId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    // Clases en vivo: lectura para usuarios autenticados; escritura solo Admin SDK
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Cursos del profesor: lectura para matriculados o el docente; escritura solo Admin SDK
    match /courses/{courseId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.professorId ||
        request.auth.uid in resource.data.studentIds
      );
      allow write: if false;
    }

    // Asistencia a clases: solo servidor (Admin SDK)
    match /class_attendance/{recordId} {
      allow read, write: if false;
    }

    // Notificaciones de logros del usuario
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
